{
  "schema": 1,
  "routes": [
    {
      "id": "CLI.PLAN",
      "title": "完整 plan 请求",
      "symptoms": [
        "plan 失败",
        "profile 不对",
        "MAA 与文本不一致",
        "完整方案"
      ],
      "entrypoints": [
        "crates/infra-cli/src/main.rs::run",
        "crates/infra-cli/src/commands/plan_compute.rs::compute_plan"
      ],
      "chain_doc": "docs/调用链/plan请求.md",
      "module_docs": [
        "docs/接口/CLI与Worker.md",
        "docs/模块/排班与轮换.md"
      ],
      "mechanics": [
        "docs/知识库引用.md#solver-文档的引用格式"
      ],
      "verification": [
        "infra-cli plan --operbox <path> --profile-out out/<task>-profile.json --maa-out out/<task>-maa.json"
      ],
      "vault_refs": [
        "docs/4-排班算法/可露希尔基建终端排班机制.md",
        "docs/5-换班操作/定时换班.md"
      ],
      "priority": 65,
      "when": "请求入口、默认参数、Worker/CLI 汇合或 profile/MAA 同源问题时选择。"
    },
    {
      "id": "LAYOUT.SHIFT",
      "title": "单班布局与设施填充",
      "symptoms": [
        "干员被抢",
        "体系未激活",
        "房间没填满",
        "候选池异常"
      ],
      "entrypoints": [
        "crates/infra-core/src/layout/assign.rs::assign_shift_with_plan_skip",
