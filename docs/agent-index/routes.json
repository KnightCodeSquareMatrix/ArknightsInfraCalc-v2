        "docs/模块/候选搜索与Bake.md",
        "docs/模块/中枢与跨设施状态.md"
      ],
      "mechanics": [
        "docs/知识库引用.md#可引用范围"
      ],
      "verification": [
        "infra-cli layout test --layout <path> --operbox <path>"
      ],
      "vault_refs": [
        "docs/1-基础设定/设施与进驻/基建总览.md",
        "docs/3-组合库/组合注册表.md"
