{
  "schema": 1,
  "routes": [
    {
      "id": "CLI.PLAN",
      "title": "完整 plan 请求",
      "symptoms": ["plan 失败", "profile 不对", "MAA 与文本不一致", "完整方案"],
      "entrypoints": ["crates/infra-cli/src/main.rs::run", "crates/infra-cli/src/commands/plan_compute.rs::compute_plan"],
      "chain_doc": "docs/调用链/plan请求.md",
      "module_docs": ["docs/接口/CLI与Worker.md", "docs/模块/排班与轮换.md"],
      "mechanics": ["docs/知识库引用.md#solver-文档的引用格式"],
      "verification": ["infra-cli plan --operbox <path> --profile-out out/<task>-profile.json --maa-out out/<task>-maa.json"]
    },
    {
      "id": "LAYOUT.SHIFT",
      "title": "单班布局与设施填充",
      "symptoms": ["干员被抢", "体系未激活", "房间没填满", "候选池异常"],
      "entrypoints": ["crates/infra-core/src/layout/assign.rs::assign_shift_with_plan_skip", "crates/infra-core/src/layout/orchestrate/select.rs::build_plan"],
      "chain_doc": "docs/调用链/跨设施状态刷新.md",
      "module_docs": ["docs/模块/候选搜索与Bake.md", "docs/模块/中枢与跨设施状态.md"],
      "mechanics": ["docs/知识库引用.md#可引用范围"],
      "verification": ["infra-cli layout test --layout <path> --operbox <path>"]
    },
    {
      "id": "SOLVER.TRADE_ROOM",
      "title": "贸易站单房结算",
      "symptoms": ["贸易效率错误", "订单类型错误", "shortcut 未命中", "单位产出异常"],
      "entrypoints": ["crates/infra-core/src/trade/solver.rs::solve_trade_with_shift", "crates/infra-core/src/trade/interpreter.rs"],
      "chain_doc": "docs/调用链/技能到房间结算.md",
      "module_docs": ["docs/模块/贸易求解.md", "docs/模块/输入与技能映射.md"],
      "mechanics": ["docs/知识库引用.md#可引用范围"],
      "verification": ["infra-cli verify --all", "infra-cli trade yield <fixture>"]
    },
    {
      "id": "ROTATION.TIMED",
      "title": "定时轮换",
      "symptoms": ["班次互斥错误", "同上同下错误", "profile 不识别", "休息状态错误"],
      "entrypoints": ["crates/infra-core/src/schedule/team_rotation.rs::schedule_timed_rotation"],
      "chain_doc": "docs/调用链/定时轮换.md",
      "module_docs": ["docs/模块/排班与轮换.md", "docs/模块/导出与岗位状态.md"],
      "mechanics": ["docs/知识库引用.md#可引用范围"],
      "verification": ["infra-cli layout team-rotation --layout <path> --operbox <path> --json"]
    },
    {
      "id": "EXPORT.MAA",
      "title": "MAA 导出",
      "symptoms": ["MAA 字段错误", "导出房间与 assignment 不同", "轮换数量错误"],
      "entrypoints": ["crates/infra-core/src/export/maa.rs::build_from_team_rotation"],
      "chain_doc": "docs/调用链/MAA导出.md",
      "module_docs": ["docs/模块/导出与岗位状态.md", "docs/接口/输入输出与兼容.md"],
      "mechanics": ["docs/知识库引用.md#唯一边界"],
      "verification": ["infra-cli plan --operbox <path> --maa-out out/<task>-maa.json"]
    },
    {
      "id": "DIAGNOSTICS.DEBUG",
      "title": "debug bundle 重放",
      "symptoms": ["线上反馈复现", "求解错误", "某房间异常", "某干员未进池"],
      "entrypoints": ["crates/infra-cli/src/commands/debug.rs::debug_cmd"],
      "chain_doc": "docs/调用链/debug与验证.md",
      "module_docs": ["docs/接口/错误与诊断.md", "docs/模块/候选搜索与Bake.md"],
      "mechanics": ["docs/知识库引用.md#不可混淆的四种内容"],
      "verification": ["infra-cli debug rerun --bundle <debug-bundle.json>"]
    }
  ]
}
