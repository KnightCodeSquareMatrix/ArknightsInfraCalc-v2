{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arknights-infra-calc.local/contracts/training-advice-narrative-v1.schema.json",
  "type": "object",
  "required": ["status", "narrative", "structured_report"],
  "properties": {
    "status": {"enum": ["ready", "fallback", "processing"]},
    "fallback_reason": {"type": ["string", "null"]},
    "structured_report": {"type": "object", "required": ["schema_version"]},
    "narrative": {
      "type": ["object", "null"],
      "required": ["schema_version", "sections"],
      "properties": {
        "schema_version": {"const": 1},
        "sections": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["id", "heading"],
            "properties": {
              "id": {"type": "string"},
              "heading": {"type": "string"},
              "paragraphs": {"type": "array", "items": {"type": "string"}},
              "items": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
