{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arknights-infra-calc.local/contracts/agent-harness-v0.schema.json",
  "title": "Agent Harness Protocol v0",
  "description": "Harness-neutral task, child-session, result, proof-obligation and evidence-overlay contracts.",
  "type": "object",
  "required": ["protocol_version", "task"],
  "properties": {
    "protocol_version": {
      "const": "agent-harness-v0"
    },
    "task": {
      "$ref": "#/$defs/taskRecord"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "taskState": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "waiting",
        "succeeded",
        "failed",
        "cancelled",
        "expired",
        "blocked"
      ]
    },
    "proofState": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "partial",
        "failed",
        "blocked",
        "not_run"
      ]
    },
    "guaranteeClass": {
      "type": "string",
      "enum": [
        "hard_constraint",
        "safe_reduction",
        "heuristic",
        "policy",
        "approximation",
        "unknown",
        "not_applicable"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "statement",
        "source_layer",
        "confidence",
        "guarantee_class"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "fact",
            "inference",
            "unknown",
            "unsupported",
            "policy",
            "decision"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source_layer": {
          "type": "string",
          "enum": [
            "user",
            "canonical",
            "code",
            "generated_help",
            "json_fixture",
            "evidence",
            "agent_inference",
            "external_source"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confidence": {
          "type": "string",
          "enum": ["verified", "supported", "tentative", "unknown"]
        },
        "guarantee_class": {
          "$ref": "#/$defs/guaranteeClass"
        },
        "canonical_conflict": {
          "type": "boolean"
        },
        "negative_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewer_required": {
          "type": "boolean"
        }
      }
    },
    "proofObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "required", "status"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "invariant",
            "targeted_test",
            "full_suite",
            "cli",
            "performance",
            "format",
            "structure",
            "review",
            "privacy"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/proofState"
        },
        "profile": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "sha256", "visibility"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "transcript",
            "findings",
            "evidence_log",
            "evidence_manifest",
            "test_report",
            "benchmark",
            "diff",
            "checkpoint",
            "memory",
            "other"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "project", "private", "provider_forbidden"]
        },
        "retention": {
          "type": "string",
          "enum": ["run", "task", "delivery", "long_term", "unknown"]
        }
      }
    },
    "childTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "task", "state", "write_policy"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "type": "string",
          "enum": [
            "domain_explorer",
            "evidence_researcher",
            "solver_reviewer",
            "executor",
            "memory_writer",
            "custom"
          ]
        },
        "task": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/taskState"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "write_policy": {
          "type": "string",
          "enum": ["readonly", "isolated_worktree", "single_writer"]
        },
        "result_ref": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "task_id", "type", "occurred_at"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "enum": [
            "queued",
            "started",
            "progress",
            "waiting",
            "succeeded",
            "failed",
            "cancel_requested",
            "cancelled",
            "expired",
            "resumed"
          ]
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "idempotency_key": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object"
        }
      }
    },
    "taskRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "protocol_version",
        "project_profile",
        "state",
        "write_policy",
        "data_classification",
        "proof_obligations",
        "children"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "protocol_version": {
          "const": "agent-harness-v0"
        },
        "project_profile": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "#/$defs/taskState"
        },
        "write_policy": {
          "type": "string",
          "enum": ["readonly", "isolated_worktree", "single_writer"]
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "dirty_worktree": {
          "type": "boolean"
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtime": {
          "type": "string"
        },
        "runtime_version": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "data_classification": {
          "type": "string",
          "enum": ["public", "project", "private", "mixed"]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/childTask"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "proof_obligations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proofObligation"
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "worktree": {
          "type": "string"
        },
        "resource_class": {
          "type": "string",
          "enum": ["readonly", "cpu_light", "cpu_bound", "benchmark", "external_io"]
        },
        "adapter_probe": {
          "type": "object"
        },
        "approval_required": {
          "type": "boolean"
        },
        "approval": {
          "$ref": "#/$defs/approval"
        },
        "research_wave": {
          "$ref": "#/$defs/researchWave"
        }
      }
    },
    "researchWave": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "wave_id", "scope", "join_policy", "result_contracts"],
      "properties": {
        "protocol_version": {"const": "research-wave-v0"},
        "wave_id": {"$ref": "#/$defs/id"},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["writes", "private_inputs", "business_commands", "runtime_start", "data_classification"],
          "properties": {
            "writes": {"const": false},
            "private_inputs": {"const": false},
            "business_commands": {"const": false},
            "runtime_start": {"const": false},
            "data_classification": {"const": "public"}
          }
        },
        "join_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "required_children", "fail_closed"],
          "properties": {
            "mode": {"const": "all_required"},
            "required_children": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
            "fail_closed": {"const": true}
          }
        },
        "result_contracts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["child_id", "required_output"],
            "properties": {
              "child_id": {"$ref": "#/$defs/id"},
              "required_output": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "approver", "approved_at", "scope", "scope_hash", "reason"],
      "properties": {
        "decision_id": {"$ref": "#/$defs/id"},
        "approver": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "minLength": 1},
        "scope": {"type": "object"},
        "scope_hash": {"$ref": "#/$defs/sha256"},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
