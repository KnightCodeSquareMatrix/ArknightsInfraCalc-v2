# BFF / Python narrator adapter configuration.
TRAINING_ADVICE_LLM_PROVIDER=openai
TRAINING_ADVICE_LLM_BASE_URL=https://api.openai.com/v1
TRAINING_ADVICE_LLM_MODEL=
TRAINING_ADVICE_LLM_API_KEY=
TRAINING_ADVICE_LLM_REQUEST_TIMEOUT_MS=12000
TRAINING_ADVICE_NARRATIVE_TASK_DEADLINE_MS=20000
TRAINING_ADVICE_NARRATIVE_LOCK_TTL_SECONDS=30
TRAINING_ADVICE_LLM_MAX_OUTPUT_TOKENS=2200
TRAINING_ADVICE_NARRATIVE_MAX_CHARS=6000

# BFF-owned controls. These are documented here but are not read by the core adapter.
TRAINING_ADVICE_NARRATIVE_PROVIDER_CONCURRENCY=8
TRAINING_ADVICE_NARRATIVE_QUEUE_LIMIT=100
TRAINING_ADVICE_NARRATIVE_READY_TTL_SECONDS=86400
TRAINING_ADVICE_NARRATIVE_FALLBACK_TTL_SECONDS=300
TRAINING_ADVICE_NARRATIVE_PROCESSING_TTL_SECONDS=45
